# Copy to .env and fill in real values. Never commit .env.
# Key names only here; this file carries no secrets.
GEMINI_API_KEY=
NEATLOGS_API_KEY=
SWAPDESK_MODEL=gemini-3.8-flash
LITELLM_API_KEY=
# Optional override; defaults to the hackathon LiteLLM proxy. Not secret.
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
# With LITELLM_API_KEY set, SWAPDESK_MODEL picks one of: nova-micro,
# nova-lite, nova-pro, nova-2-lite, claude-haiku, claude-sonnet-4.6,
# claude-opus-4.6 (default claude-haiku). Without it, SWAPDESK_MODEL is
# a Gemini model id (default gemini-3.8-flash).
NEATLOGS_PROJECT_ID=